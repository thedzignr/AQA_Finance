# AQA Finance environment configuration
#
# The app runs in a fully offline "mock" mode out of the box (seeded demo data,
# mock OCR/parsing adapters). To connect a real Supabase project, fill these in.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key
VITE_SUPABASE_ANON_KEY=

# Data backend: "mock" (default, local seeded data) or "supabase".
# If left as "mock" or if the keys above are blank, the app uses the local
# in-memory repository seeded from src/data/seed.ts.
VITE_DATA_BACKEND=mock
