# AQA Finance environment configuration
#
# The app stores all data in your own Supabase project behind email/password
# auth. Set both values below (from Supabase → Project Settings → API), then
# restart the dev server. Until they're set, the app shows a "Connect Supabase"
# screen.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key
VITE_SUPABASE_ANON_KEY=

# --- Receive-only receipts inbox (server) ---
# Never used to send mail. Attachments posted to this address are ingested
# into Documents + Review via POST /api/inbound-email.
#
# Resend API key (from the Resend marketplace install)
RESEND_API_KEY=
# Svix signing secret for the email.received webhook
RESEND_WEBHOOK_SECRET=
# Supabase service role — required to store inbound files. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Auth user id that owns inbound documents (otherwise first profiles row).
AQA_INGEST_USER_ID=

# Address shown in the app for parking barriers, invoices, receipts, etc.
# Example: receipts@xxxx.resend.app
VITE_INBOUND_MAILBOX=
